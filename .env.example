# Copy to .env and fill in your values. Do not commit .env (it is in .gitignore).

# Discord bot token (required to run the bot)
DISCORD_TOKEN=

# Optional: guild ID for instant slash-command sync on startup (global sync can take ~1 hour)
DISCORD_GUILD_ID=

# MySQL database (used by error logging / analytics parity)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_AUTOCOMMIT=true

# Lavalink (music playback)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# Music web dashboard
MUSIC_HTTP_PORT=8790
MUSIC_PUBLIC_BASE_URL=https://music.kartersanamo.com
MUSIC_SESSION_TTL_SECONDS=86400

# Discord OAuth for music dashboard
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://music.kartersanamo.com/oauth/callback
